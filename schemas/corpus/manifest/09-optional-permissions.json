{
  "description": "Optional library, queue, playback and fingerprint permissions.",
  "valid": true,
  "value": {
    "formatVersion": 1,
    "id": "org.hakone.tvmaze",
    "name": "TVmaze episode titles",
    "version": "0.3.0",
    "publisher": "Hakone core",
    "license": "GPL-2.0-or-later",
    "source": "https://github.com/hakone-org/addon-tvmaze.git",
    "api": {
      "addon": ">=1.0.0 <2.0.0",
      "contracts": {
        "metadata": "^1.0.0"
      }
    },
    "runtime": {
      "kind": "wasm-message-v1",
      "entry": "dist/addon.wasm",
      "selfTest": true
    },
    "files": [
      "addon.json",
      "LICENSE",
      "NOTICE.md",
      "dist/addon.wasm"
    ],
    "contributions": [
      {
        "id": "episodes",
        "type": "metadata.provider",
        "contract": "metadata@1",
        "features": [
          "video.details",
          "video.identity"
        ],
        "mediaKinds": [
          "episode"
        ],
        "operations": [
          "identify",
          "enrich"
        ],
        "requires": [
          "metadata.context",
          "network.http",
          "library.read",
          "media.fingerprint"
        ]
      }
    ],
    "permissions": {
      "required": {
        "metadata.context": {
          "fields": [
            "kind",
            "title",
            "year",
            "season",
            "episodes",
            "ids",
            "externalIds",
            "episode"
          ]
        }
      },
      "optional": {
        "library.read": {
          "collections": [
            "tracks",
            "albums"
          ],
          "fields": [
            "title",
            "artist",
            "trackNumber"
          ]
        },
        "queue.read": {},
        "queue.modify": {
          "operations": [
            "append"
          ]
        },
        "playback.observe": {
          "fields": [
            "position"
          ]
        },
        "playback.control": {
          "operations": [
            "pause"
          ]
        },
        "media.fingerprint": {
          "algorithms": [
            "opensubtitles-hash"
          ]
        },
        "network.http": {
          "origins": [
            "https://api.tvmaze.com"
          ]
        }
      }
    }
  }
}
