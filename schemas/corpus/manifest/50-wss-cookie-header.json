{
  "description": "A WSS credential binding uses the Cookie header.",
  "valid": false,
  "value": {
    "formatVersion": 1,
    "id": "org.hakone.example.midnight",
    "name": "Midnight",
    "version": "1.0.0",
    "publisher": "Hakone add-on examples",
    "license": "GPL-2.0-or-later",
    "source": "https://github.com/hakone-org/addon-midnight.git",
    "api": {
      "addon": ">=1.0.0 <2.0.0",
      "contracts": {
        "theme": "^1.0.0",
        "settings": "^1.0.0"
      }
    },
    "files": [
      "addon.json",
      "LICENSE",
      "README.md",
      "themes/midnight.json",
      "settings/schema.json"
    ],
    "contributions": [
      {
        "id": "midnight",
        "type": "theme",
        "contract": "theme@1",
        "name": "Midnight",
        "resource": "themes/midnight.json"
      }
    ],
    "permissions": {
      "optional": {
        "network.websocket": {
          "origins": [
            "wss://live.example.org"
          ]
        },
        "credentials.use": {
          "bindings": [
            {
              "field": "token",
              "origin": "wss://live.example.org",
              "header": "Cookie",
              "prefix": "Bearer "
            }
          ]
        }
      }
    },
    "settings": {
      "version": 1,
      "schema": "settings/schema.json"
    }
  }
}
