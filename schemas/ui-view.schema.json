{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakone.invalid/schemas/ui-view.schema.json",
  "title": "UI view document (ui@1)",
  "description": "A data-only view document that the host renders with its own components. The host does not run package code. Validator: validateView in modules/gui/qt/player/qml/redesign/AddonUi.js. Contract: contrib-addons/sdk/ui-document.md.",
  "$comment": "Host-only rules that this schema cannot express: (1) The command in action, primaryAction, moreAction and each menu entry action must be in the command registry of the package (the commands list that the host supplies). (2) The complete view has at most 256 components. (3) The complete document has at most 10,000 JSON values and 131,072 UTF-16 code units across all strings. (4) The complete document has at most 20 nested JSON levels. This limit includes component nesting, so the effective component depth is less than the ten-level component limit, and deep command arguments in deep components are refused. (5) The host counts string lengths in UTF-16 code units. JSON Schema maxLength counts code points, so a string with characters outside the Basic Multilingual Plane can pass this schema and fail the host. (6) State projection checks (bound values have the correct type, list keys are present and different, tab entries have a key and a label, at most 64 tabs) run on each state update, not on the document.",
  "type": "object",
  "required": [
    "contract",
    "id",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ui@1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "identifier": {
      "description": "An identifier: an ASCII letter or underscore, then at most 95 letters, digits, underscores, full stops or hyphens. Reserved object names are not permitted.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,95}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "bindingPath": {
      "description": "A property path that starts with state or item. Each part follows the identifier rules and contains no full stop. No expressions or index access.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^(state|item)(\\.[A-Za-z_][A-Za-z0-9_-]{0,95})+$",
      "not": {
        "pattern": "\\.(__proto__|prototype|constructor)(\\.|$)"
      }
    },
    "binding": {
      "description": "A binding to view state or to the current list item.",
      "type": "object",
      "required": [
        "bind"
      ],
      "additionalProperties": false,
      "properties": {
        "bind": {
          "$ref": "#/$defs/bindingPath"
        }
      }
    },
    "message": {
      "description": "A key in the host locale dictionary of the package. The host shows the key when the dictionary has no value.",
      "type": "object",
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "text": {
      "description": "Plain text, a message or a binding.",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "$ref": "#/$defs/message"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "label": {
      "description": "A required label: text that is not empty, a message or a binding.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        {
          "$ref": "#/$defs/message"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "flag": {
      "description": "A Boolean or a binding. A message is not permitted.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "progress": {
      "description": "A number or a binding. The host limits the displayed value to zero through one.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "commandId": {
      "description": "A command identifier in the form package.id/command-id.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,127}/[A-Za-z0-9_.-]{1,96}$"
    },
    "action": {
      "description": "A command request. The command must also be in the command registry of the package (host-only check).",
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/commandId"
        },
        "arguments": {
          "$ref": "#/$defs/argument0"
        }
      }
    },
    "argument0": {
      "description": "A command argument value at nesting level 0. An object that has bind or message is a value binding. Containers have at most 32 entries.",
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number"
          ]
        },
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "$ref": "#/$defs/message"
        },
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "bind"
                ]
              },
              {
                "required": [
                  "message"
                ]
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument1"
          }
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/argument1"
          }
        }
      ]
    },
    "argument1": {
      "description": "A command argument value at nesting level 1. An object that has bind or message is a value binding. Containers have at most 32 entries.",
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number"
          ]
        },
        {
          "type": "string",
          "maxLength": 16384
        },
        {
